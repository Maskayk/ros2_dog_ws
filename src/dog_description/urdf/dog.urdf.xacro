<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dog">

    <!-- ==================== PROPERTIES ==================== -->
    <xacro:property name="trunk_l" value="0.475"/>
    <xacro:property name="trunk_w" value="0.18"/>
    <xacro:property name="trunk_h" value="0.1"/>
    <xacro:property name="trunk_m" value="6.0"/>

    <xacro:property name="hip_l" value="0.06"/>
    <xacro:property name="hip_m" value="0.2"/>
    <xacro:property name="hip_r" value="0.02"/>

    <xacro:property name="thigh_l" value="0.144"/>
    <xacro:property name="shin_l" value="0.1525"/>
    <xacro:property name="leg_m" value="0.6"/>
    <xacro:property name="leg_r" value="0.02"/>
    <xacro:property name="foot_r" value="0.025"/>

    <!-- Начальная поза стойки: IK(x=0, z=-0.22) -->
    <!-- thigh=0.76 rad, shin=-1.47 rad => нога опущена на 0.22м ниже бедра -->
    <xacro:property name="init_thigh" value="0.76"/>
    <xacro:property name="init_shin" value="-1.47"/>

    <!-- ==================== MATERIALS ==================== -->
    <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    <material name="grey"><color rgba="0.6 0.6 0.6 1"/></material>

    <!-- ==================== INERTIA MACROS ==================== -->
    <!-- Box inertia (CoM в центре box) -->
    <xacro:macro name="box_inertia" params="m l w h">
        <inertial>
            <mass value="${m}"/>
            <inertia ixx="${m/12*(w*w+h*h)}" ixy="0" ixz="0"
                     iyy="${m/12*(l*l+h*h)}" iyz="0"
                     izz="${m/12*(l*l+w*w)}"/>
        </inertial>
    </xacro:macro>

    <!-- Cylinder inertia со смещённым центром масс -->
    <xacro:macro name="cylinder_inertia_offset" params="m r h ox oy oz">
        <inertial>
            <origin xyz="${ox} ${oy} ${oz}"/>
            <mass value="${m}"/>
            <inertia ixx="${m/12*(3*r*r+h*h)}" ixy="0" ixz="0"
                     iyy="${m/12*(3*r*r+h*h)}" iyz="0"
                     izz="${m*r*r/2}"/>
        </inertial>
    </xacro:macro>

    <!-- ==================== TRUNK ==================== -->
    <link name="base_link">
        <visual><geometry><box size="0.01 0.01 0.01"/></geometry></visual>
    </link>
    <joint name="base_joint" type="fixed">
        <parent link="base_link"/><child link="trunk"/>
    </joint>

    <link name="trunk">
        <visual>
            <geometry><box size="${trunk_l} ${trunk_w} ${trunk_h}"/></geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry><box size="${trunk_l} ${trunk_w} ${trunk_h}"/></geometry>
        </collision>
        <xacro:box_inertia m="${trunk_m}" l="${trunk_l}" w="${trunk_w}" h="${trunk_h}"/>
    </link>

    <!-- ==================== FOOT FRICTION MACRO ==================== -->
    <xacro:macro name="foot_friction" params="prefix">
        <gazebo reference="${prefix}_shin">
            <mu1>1.5</mu1>
            <mu2>1.5</mu2>
            <kp>100000.0</kp>
            <kd>100.0</kd>
            <minDepth>0.001</minDepth>
        </gazebo>
    </xacro:macro>

    <!-- ==================== LEG MACRO ==================== -->
    <xacro:macro name="dog_leg" params="prefix side_x side_y">

        <!-- 1. HIP (Roll) -->
        <joint name="${prefix}_hip_joint" type="revolute">
            <parent link="trunk"/> <child link="${prefix}_hip"/>
            <origin xyz="${side_x * trunk_l/2} ${side_y * trunk_w/2} 0" rpy="0 0 0"/>
            <axis xyz="1 0 0"/>
            <limit lower="-0.5" upper="0.5" effort="20" velocity="10"/>
            <dynamics damping="1.0" friction="0.3"/>
        </joint>
        <link name="${prefix}_hip">
            <visual>
                <origin xyz="0 ${side_y * hip_l/2} 0" rpy="${pi/2} 0 0"/>
                <geometry><cylinder radius="${hip_r}" length="${hip_l}"/></geometry>
                <material name="black"/>
            </visual>
            <xacro:cylinder_inertia_offset m="${hip_m}" r="${hip_r}" h="${hip_l}"
                ox="0" oy="${side_y * hip_l/2}" oz="0"/>
        </link>

        <!-- 2. THIGH (Pitch) -->
        <joint name="${prefix}_thigh_joint" type="revolute">
            <parent link="${prefix}_hip"/> <child link="${prefix}_thigh"/>
            <origin xyz="0 ${side_y * hip_l} 0" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
            <limit lower="-0.5" upper="2.5" effort="20" velocity="10"/>
            <dynamics damping="1.0" friction="0.3"/>
        </joint>
        <link name="${prefix}_thigh">
            <visual>
                <origin xyz="0 0 ${-thigh_l/2}"/>
                <geometry><cylinder radius="${leg_r}" length="${thigh_l}"/></geometry>
                <material name="grey"/>
            </visual>
            <collision>
                <origin xyz="0 0 ${-thigh_l/2}"/>
                <geometry><cylinder radius="${leg_r}" length="${thigh_l - 0.04}"/></geometry>
            </collision>
            <xacro:cylinder_inertia_offset m="${leg_m}" r="${leg_r}" h="${thigh_l}"
                ox="0" oy="0" oz="${-thigh_l/2}"/>
        </link>

        <!-- 3. SHIN (Pitch) -->
        <joint name="${prefix}_shin_joint" type="revolute">
            <parent link="${prefix}_thigh"/> <child link="${prefix}_shin"/>
            <origin xyz="0 0 ${-thigh_l}" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
            <limit lower="-2.7" upper="-0.3" effort="20" velocity="10"/>
            <dynamics damping="1.0" friction="0.3"/>
        </joint>
        <link name="${prefix}_shin">
            <visual>
                <origin xyz="0 0 ${-shin_l/2}"/>
                <geometry><cylinder radius="${leg_r*0.8}" length="${shin_l}"/></geometry>
                <material name="black"/>
            </visual>
            <collision>
                <origin xyz="0 0 ${-shin_l/2}"/>
                <geometry><cylinder radius="${leg_r*0.8}" length="${shin_l}"/></geometry>
            </collision>
            <!-- Foot sphere -->
            <collision>
                <origin xyz="0 0 ${-shin_l}"/>
                <geometry><sphere radius="${foot_r}"/></geometry>
            </collision>
            <xacro:cylinder_inertia_offset m="${leg_m}" r="${leg_r*0.8}" h="${shin_l}"
                ox="0" oy="0" oz="${-shin_l/2}"/>
        </link>

        <xacro:foot_friction prefix="${prefix}"/>

    </xacro:macro>

    <!-- ==================== INSTANTIATE LEGS ==================== -->
    <xacro:dog_leg prefix="front_left"  side_x="1"  side_y="1"/>
    <xacro:dog_leg prefix="front_right" side_x="1"  side_y="-1"/>
    <xacro:dog_leg prefix="rear_left"   side_x="-1" side_y="1"/>
    <xacro:dog_leg prefix="rear_right"  side_x="-1" side_y="-1"/>

    <!-- ==================== ROS2 CONTROL ==================== -->
    <ros2_control name="GazeboSystem" type="system">
        <hardware><plugin>gazebo_ros2_control/GazeboSystem</plugin></hardware>
        <xacro:macro name="init_pos" params="name t s">
            <joint name="${name}_hip_joint">
                <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
                <command_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
            <joint name="${name}_thigh_joint">
                <state_interface name="position"><param name="initial_value">${t}</param></state_interface>
                <command_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
            <joint name="${name}_shin_joint">
                <state_interface name="position"><param name="initial_value">${s}</param></state_interface>
                <command_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
        </xacro:macro>
        <xacro:init_pos name="front_left"  t="${init_thigh}" s="${init_shin}"/>
        <xacro:init_pos name="front_right" t="${init_thigh}" s="${init_shin}"/>
        <xacro:init_pos name="rear_left"   t="${init_thigh}" s="${init_shin}"/>
        <xacro:init_pos name="rear_right"  t="${init_thigh}" s="${init_shin}"/>
    </ros2_control>

    <!-- ==================== GAZEBO PLUGINS ==================== -->
    <gazebo>
        <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
            <parameters>$(find dog_bringup)/config/controllers.yaml</parameters>
        </plugin>
    </gazebo>

    <!-- IMU Sensor on trunk -->
    <gazebo reference="trunk">
        <sensor name="imu_sensor" type="imu">
            <always_on>true</always_on>
            <update_rate>100</update_rate>
            <imu>
                <angular_velocity>
                    <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
                </angular_velocity>
                <linear_acceleration>
                    <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
                </linear_acceleration>
            </imu>
            <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
                <ros>
                    <remapping>~/out:=/imu/data</remapping>
                </ros>
                <initial_orientation_as_reference>false</initial_orientation_as_reference>
                <frame_name>trunk</frame_name>
            </plugin>
        </sensor>
    </gazebo>

</robot>
